{
  "name": "pi-semantic-screen",
  "version": "0.5.3",
  "type": "module",
  "description": "Adapter-driven semantic screening and extension-owned evidence review for Pi",
  "keywords": [
    "pi-package",
    "classifier",
    "codemode",
    "semantic-screening",
    "batch-screening",
    "adapters",
    "presets"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/screen.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:offline": "tsc -p tsconfig.offline.json --noEmit",
    "test:codemode": "node test/codemode-smoke.mjs",
    "check": "npm test && npm run typecheck:offline",
    "pack:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "files": [
    "extensions/",
    "src/",
    "skills/",
    "prompts/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "LICENSE"
  ]
}
